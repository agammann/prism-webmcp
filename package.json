{
  "name": "prism",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/sandbox-vinext.mjs dev",
    "build": "node scripts/sandbox-vinext.mjs build",
    "test": "tsx --test test/*.test.ts extension/test/*.test.js && node scripts/verify-webmcp-evals.mjs && node scripts/verify-security-headers.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:webmcp": "playwright test --config playwright.webmcp.config.ts",
    "test:companion:native": "playwright test --config playwright.companion.config.ts",
    "package:companion": "node scripts/package-companion.mjs",
    "verify:companion": "node scripts/package-companion.mjs --check",
    "test:audit-policy": "node --test scripts/audit-policy.test.mjs",
    "security:audit": "node scripts/audit-policy.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20260930.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "fflate": "0.8.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.21.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.145.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "license": "MIT"
}
